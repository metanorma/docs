// ISO/IEC Label Style Definition in LutaML
// Based on LADL specification in document.adoc

// Main label style instance for ISO/IEC
LabelStyle "ISOIECLabelStyle" {
  name = "ISO/IEC Label Style"
  definition {
    The ISO/IEC label style originates from and implements the requirements of:
    * the ISO/IEC Directives, Part 2
    * the ISO House Style.

    This style defines the labeling scheme used by ISO/IEC deliverables.
  }

  // References to all labellers defined in this style
  labellers = [
    "id:clause_labeller",
    "id:subclause_labeller",
    "id:annex_labeller",
    "id:annex_clause_labeller",
    "id:figure_labeller",
    "id:annex_figure_labeller",
    "id:subfigure_labeller",
    "id:table_labeller",
    "id:annex_table_labeller",
    "id:note_labeller",
    "id:example_labeller",
    "id:formula_labeller",
    "id:annex_formula_labeller",
    "id:list_labeller",
    "id:annex_list_labeller",
    "id:unordered_list_item_labeller",
    "id:ordered_list_item_level1_labeller",
    "id:ordered_list_item_level2_labeller",
    "id:ordered_list_item_level3_labeller",
    "id:ordered_list_item_level4_labeller"
  ]

  // References to all sequences used in this style
  sequences = [
    ref:(DecimalNumericSequence),
    ref:(AlphaLowerNumericSequence),
    ref:(AlphaUpperNumericSequence),
    ref:(RomanLowerNumericSequence)
  ]

  // References to all templates used in this style
  templates = [
    ref:(ClauseLabelTemplate),
    ref:(ClauseGlobalLabelTemplate),
    ref:(SubclauseLabelTemplate),
    ref:(SubclauseGlobalLabelTemplate),
    ref:(AnnexLabelTemplate),
    ref:(AnnexGlobalLabelTemplate),
    ref:(AnnexClauseLabelTemplate),
    ref:(AnnexClauseGlobalLabelTemplate),
    ref:(FigureLabelTemplate),
    ref:(FigureGlobalLabelTemplate),
    ref:(AnnexFigureLabelTemplate),
    ref:(AnnexFigureGlobalLabelTemplate),
    ref:(SubfigureLabelTemplate),
    ref:(SubfigureGlobalLabelTemplate),
    ref:(TableLabelTemplate),
    ref:(TableGlobalLabelTemplate),
    ref:(AnnexTableLabelTemplate),
    ref:(AnnexTableGlobalLabelTemplate),
    ref:(NoteSingleLabelTemplate),
    ref:(NoteMultipleLabelTemplate),
    ref:(NoteSingleGlobalLabelTemplate),
    ref:(NoteMultipleGlobalLabelTemplate),
    ref:(ExampleSingleLabelTemplate),
    ref:(ExampleMultipleLabelTemplate),
    ref:(ExampleSingleGlobalLabelTemplate),
    ref:(ExampleMultipleGlobalLabelTemplate),
    ref:(FormulaLabelTemplate),
    ref:(FormulaGlobalLabelTemplate),
    ref:(AnnexFormulaLabelTemplate),
    ref:(AnnexFormulaGlobalLabelTemplate),
    ref:(ListLabelTemplate),
    ref:(ListGlobalLabelTemplate),
    ref:(AnnexListLabelTemplate),
    ref:(AnnexListGlobalLabelTemplate),
    ref:(UnorderedListItemLabelTemplate),
    ref:(OrderedListItemLevel1LabelTemplate),
    ref:(OrderedListItemLevel2LabelTemplate),
    ref:(OrderedListItemLevel3LabelTemplate),
    ref:(OrderedListItemLevel4LabelTemplate)
  ]

  // References to all contexts used in this style
  contexts = [
    ref:(DocumentContext),
    ref:(ClauseContext),
    ref:(SubclauseContext),
    ref:(AnnexContext),
    ref:(AnnexClauseContext),
    ref:(ListContext)
  ]
}

// Define the document context
LabelContext "DocumentContext" {
  name = "document"
  definition "Top-level document context for ISO/IEC documents"
}

// Clause labeling
LabelContext "ClauseContext" {
  name = "clause"
  parent = ref:(DocumentContext)
  definition "Context for clauses within the main document"
}

LabelContext "SubclauseContext" {
  name = "subclause"
  parent = ref:(ClauseContext)
  definition "Context for subclauses within clauses"
}

// Clause templates
LabelTemplate "ClauseLabelTemplate" {
  pattern = "Clause %n"
  definition "Template for local clause references"
}

LabelTemplate "ClauseGlobalLabelTemplate" {
  pattern = "Clause %n"
  definition "Template for global clause references"
}

Labeller "ClauseLabeller" {
  id = "clause_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
  type = "clause"
  template = ref:(ClauseLabelTemplate)
  global_template = ref:(ClauseGlobalLabelTemplate)
  definition "Labeller for clauses in the main document"
}

// Subclause templates
LabelTemplate "SubclauseLabelTemplate" {
  pattern = "%pn.%n"
  definition "Template for local subclause references"
}

LabelTemplate "SubclauseGlobalLabelTemplate" {
  pattern = "%pn.%n"
  definition "Template for global subclause references"
}

Labeller "SubclauseLabeller" {
  id = "subclause_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  parent = ref:(ClauseLabeller)
  type = "subclause"
  template = ref:(SubclauseLabelTemplate)
  global_template = ref:(SubclauseGlobalLabelTemplate)
  definition "Labeller for subclauses within clauses"
}

// Annex labeling
LabelContext "AnnexContext" {
  name = "annex"
  parent = ref:(DocumentContext)
  definition "Context for annexes within the document"
}

LabelContext "AnnexClauseContext" {
  name = "annex_clause"
  parent = ref:(AnnexContext)
  definition "Context for clauses within annexes"
}

LabelTemplate "AnnexLabelTemplate" {
  pattern = "Annex %n"
  definition "Template for local annex references"
}

LabelTemplate "AnnexGlobalLabelTemplate" {
  pattern = "Annex %n"
  definition "Template for global annex references"
}

Labeller "AnnexLabeller" {
  id = "annex_labeller"
  sequence = ref:(AlphaUpperNumericSequence)
  context = ref:(DocumentContext)
  type = "annex"
  template = ref:(AnnexLabelTemplate)
  global_template = ref:(AnnexGlobalLabelTemplate)
  definition "Labeller for annexes in the document"
}

LabelTemplate "AnnexClauseLabelTemplate" {
  pattern = "%pn.%n"
  definition "Template for local annex clause references"
}

LabelTemplate "AnnexClauseGlobalLabelTemplate" {
  pattern = "%pn.%n"
  definition "Template for global annex clause references"
}

Labeller "AnnexClauseLabeller" {
  id = "annex_clause_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "clause"
  template = ref:(AnnexClauseLabelTemplate)
  global_template = ref:(AnnexClauseGlobalLabelTemplate)
  definition "Labeller for clauses within annexes"
}

// Figure labeling
LabelTemplate "FigureLabelTemplate" {
  pattern = "Figure %n"
  definition "Template for local figure references in the main document"
}

LabelTemplate "FigureGlobalLabelTemplate" {
  pattern = "Figure %n"
  definition "Template for global figure references in the main document"
}

Labeller "FigureLabeller" {
  id = "figure_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
  type = "figure"
  template = ref:(FigureLabelTemplate)
  global_template = ref:(FigureGlobalLabelTemplate)
  definition "Labeller for figures in the main document"
}

LabelTemplate "AnnexFigureLabelTemplate" {
  pattern = "Figure %pn.%n"
  definition "Template for local figure references in annexes"
}

LabelTemplate "AnnexFigureGlobalLabelTemplate" {
  pattern = "Figure %pn.%n"
  definition "Template for global figure references in annexes"
}

Labeller "AnnexFigureLabeller" {
  id = "annex_figure_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "figure"
  template = ref:(AnnexFigureLabelTemplate)
  global_template = ref:(AnnexFigureGlobalLabelTemplate)
  definition "Labeller for figures in annexes"
}

// Subfigure labeling
LabelTemplate "SubfigureLabelTemplate" {
  pattern = "Figure %pn %n)"
  definition "Template for local subfigure references"
}

LabelTemplate "SubfigureGlobalLabelTemplate" {
  pattern = "Figure %pn %n)"
  definition "Template for global subfigure references"
}

Labeller "SubfigureLabeller" {
  id = "subfigure_labeller"
  sequence = ref:(AlphaLowerNumericSequence)
  context = ref:(DocumentContext)
  parent = ref:(FigureLabeller)
  type = "subfigure"
  template = ref:(SubfigureLabelTemplate)
  global_template = ref:(SubfigureGlobalLabelTemplate)
  definition "Labeller for subfigures in the document"
}

// Table labeling
LabelTemplate "TableLabelTemplate" {
  pattern = "Table %n"
  definition "Template for local table references in the main document"
}

LabelTemplate "TableGlobalLabelTemplate" {
  pattern = "Table %n"
  definition "Template for global table references in the main document"
}

Labeller "TableLabeller" {
  id = "table_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
  type = "table"
  template = ref:(TableLabelTemplate)
  global_template = ref:(TableGlobalLabelTemplate)
  definition "Labeller for tables in the main document"
}

LabelTemplate "AnnexTableLabelTemplate" {
  pattern = "Table %pn.%n"
  definition "Template for local table references in annexes"
}

LabelTemplate "AnnexTableGlobalLabelTemplate" {
  pattern = "Table %pn.%n"
  definition "Template for global table references in annexes"
}

Labeller "AnnexTableLabeller" {
  id = "annex_table_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "table"
  template = ref:(AnnexTableLabelTemplate)
  global_template = ref:(AnnexTableGlobalLabelTemplate)
  definition "Labeller for tables in annexes"
}

// Note labeling
LabelTemplate "NoteSingleLabelTemplate" {
  pattern = "NOTE"
  definition "Template for single note references"
}

LabelTemplate "NoteMultipleLabelTemplate" {
  pattern = "NOTE %n"
  definition "Template for multiple note references"
  condition = {
    type = "element_count_gt"
    threshold = 1
  }
}

LabelTemplate "NoteSingleGlobalLabelTemplate" {
  pattern = "%parent, NOTE"
  definition "Template for global single note references"
}

LabelTemplate "NoteMultipleGlobalLabelTemplate" {
  pattern = "%parent, NOTE %n"
  definition "Template for global multiple note references"
  condition = {
    type = "element_count_gt"
    threshold = 1
  }
}

Labeller "NoteLabeller" {
  id = "note_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  type = "note"
  template = [ref:(NoteSingleLabelTemplate), ref:(NoteMultipleLabelTemplate)]
  global_template = [ref:(NoteSingleGlobalLabelTemplate), ref:(NoteMultipleGlobalLabelTemplate)]
  definition "Labeller for notes in clauses with conditional templates based on note count"
}

// Example labeling
LabelTemplate "ExampleSingleLabelTemplate" {
  pattern = "EXAMPLE"
  definition "Template for single example references"
}

LabelTemplate "ExampleMultipleLabelTemplate" {
  pattern = "EXAMPLE %n"
  definition "Template for multiple example references"
  condition = {
    type = "element_count_gt"
    threshold = 1
  }
}

LabelTemplate "ExampleSingleGlobalLabelTemplate" {
  pattern = "%parent, EXAMPLE"
  definition "Template for global single example references"
}

LabelTemplate "ExampleMultipleGlobalLabelTemplate" {
  pattern = "%parent, EXAMPLE %n"
  definition "Template for global multiple example references"
  condition = {
    type = "element_count_gt"
    threshold = 1
  }
}

Labeller "ExampleLabeller" {
  id = "example_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  type = "example"
  template = [ref:(ExampleSingleLabelTemplate), ref:(ExampleMultipleLabelTemplate)]
  global_template = [ref:(ExampleSingleGlobalLabelTemplate), ref:(ExampleMultipleGlobalLabelTemplate)]
  definition "Labeller for examples in clauses with conditional templates based on example count"
}

// Formula labeling
LabelTemplate "FormulaLabelTemplate" {
  pattern = "(%n)"
  definition "Template for local formula references in the main document"
}

LabelTemplate "FormulaGlobalLabelTemplate" {
  pattern = "Formula (%n)"
  definition "Template for global formula references in the main document"
}

Labeller "FormulaLabeller" {
  id = "formula_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
  type = "formula"
  template = ref:(FormulaLabelTemplate)
  global_template = ref:(FormulaGlobalLabelTemplate)
  definition "Labeller for formulas in the main document"
}

LabelTemplate "AnnexFormulaLabelTemplate" {
  pattern = "(%pn.%n)"
  definition "Template for local formula references in annexes"
}

LabelTemplate "AnnexFormulaGlobalLabelTemplate" {
  pattern = "Formula (%pn.%n)"
  definition "Template for global formula references in annexes"
}

Labeller "AnnexFormulaLabeller" {
  id = "annex_formula_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "formula"
  template = ref:(AnnexFormulaLabelTemplate)
  global_template = ref:(AnnexFormulaGlobalLabelTemplate)
  definition "Labeller for formulas in annexes"
}

// List labeling
LabelContext "ListContext" {
  name = "list"
  parent = ref:(ClauseContext)
  definition "Context for lists within clauses"
}

LabelTemplate "ListLabelTemplate" {
  pattern = "List %n"
  definition "Template for local list references in the main document"
}

LabelTemplate "ListGlobalLabelTemplate" {
  pattern = "List %n"
  definition "Template for global list references in the main document"
}

Labeller "ListLabeller" {
  id = "list_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  type = "list"
  template = ref:(ListLabelTemplate)
  global_template = ref:(ListGlobalLabelTemplate)
  definition "Labeller for lists in the main document"
}

LabelTemplate "AnnexListLabelTemplate" {
  pattern = "List %pn.%n"
  definition "Template for local list references in annexes"
}

LabelTemplate "AnnexListGlobalLabelTemplate" {
  pattern = "List %pn.%n"
  definition "Template for global list references in annexes"
}

Labeller "AnnexListLabeller" {
  id = "annex_list_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "list"
  template = ref:(AnnexListLabelTemplate)
  global_template = ref:(AnnexListGlobalLabelTemplate)
  definition "Labeller for lists in annexes"
}

// List item labeling - unordered
LabelTemplate "UnorderedListItemLabelTemplate" {
  pattern = "—"
  definition "Template for unordered list items at all levels"
}

Labeller "UnorderedListItemLabeller" {
  id = "unordered_list_item_labeller"
  sequence = ref:(DecimalNumericSequence)  // Not used but required
  context = ref:(ListContext)
  type = "list_item_unordered"
  template = ref:(UnorderedListItemLabelTemplate)
  definition "Labeller for unordered list items"
}

// List item labeling - ordered, level 1 (a), b), c)...)
LabelTemplate "OrderedListItemLevel1LabelTemplate" {
  pattern = "%n)"
  definition "Template for first level ordered list items"
}

Labeller "OrderedListItemLevel1Labeller" {
  id = "ordered_list_item_level1_labeller"
  sequence = ref:(AlphaLowerNumericSequence)
  context = ref:(ListContext)
  type = "list_item_ordered_level1"
  template = ref:(OrderedListItemLevel1LabelTemplate)
  definition "Labeller for first level ordered list items"
}

// List item labeling - ordered, level 2 (1), 2), 3)...)
LabelTemplate "OrderedListItemLevel2LabelTemplate" {
  pattern = "%n)"
  definition "Template for second level ordered list items"
}

Labeller "OrderedListItemLevel2Labeller" {
  id = "ordered_list_item_level2_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ListContext)
  parent = ref:(OrderedListItemLevel1Labeller)
  type = "list_item_ordered_level2"
  template = ref:(OrderedListItemLevel2LabelTemplate)
  definition "Labeller for second level ordered list items"
}

// List item labeling - ordered, level 3 (i), ii), iii)...)
LabelTemplate "OrderedListItemLevel3LabelTemplate" {
  pattern = "%n)"
  definition "Template for third level ordered list items"
}

Labeller "OrderedListItemLevel3Labeller" {
  id = "ordered_list_item_level3_labeller"
  sequence = ref:(RomanLowerNumericSequence)
  context = ref:(ListContext)
  parent = ref:(OrderedListItemLevel2Labeller)
  type = "list_item_ordered_level3"
  template = ref:(OrderedListItemLevel3LabelTemplate)
  definition "Labeller for third level ordered list items"
}

// List item labeling - ordered, level 4 (a), b), c)... - repeats first level)
LabelTemplate "OrderedListItemLevel4LabelTemplate" {
  pattern = "%n)"
  definition "Template for fourth level ordered list items"
}

Labeller "OrderedListItemLevel4Labeller" {
  id = "ordered_list_item_level4_labeller"
  sequence = ref:(AlphaLowerNumericSequence)
  context = ref:(ListContext)
  parent = ref:(OrderedListItemLevel3Labeller)
  type = "list_item_ordered_level4"
  template = ref:(OrderedListItemLevel4LabelTemplate)
  definition "Labeller for fourth level ordered list items"
}
