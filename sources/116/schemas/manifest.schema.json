{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "generated": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Generated",
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "flavor": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "string"
    },
    "source-hash": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ManifestComponent",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "hash": {
            "type": "string"
          }
        }
      }
    },
    "license": {
      "type": "string"
    },
    "copyright": {
      "type": "string"
    }
  }
}
