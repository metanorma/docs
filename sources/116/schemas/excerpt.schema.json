{
  "$id": "https://metanorma.org/schemas/mko/excerpt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MN 116 consumer excerpt (answer contract)",
  "type": "object",
  "required": ["text"],
  "properties": {
    "text": {
      "type": "string",
      "description": "consumer-authored prose; may contain [[u:<id>]] unit references; unit DATA never passes through a generator into text"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "type", "payload"],
        "properties": {
          "unit_id": { "type": "string", "pattern": "^u:[A-Za-z0-9_.:-]+$" },
          "type": { "enum": ["table", "formula", "figure", "term", "requirement", "reference"] },
          "docidentifier": { "type": "string" },
          "edition": { "type": "string" },
          "payload": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
