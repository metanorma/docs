{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Excerpt",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "\\Au:"
          },
          "type": {
            "type": "string"
          },
          "docidentifier": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "payload": {
            "oneOf": [
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "TablePayload",
                "type": "object",
                "properties": {
                  "caption": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "title": "TableColumn",
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mirror": {
                    "type": "object"
                  }
                }
              },
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "FormulaPayload",
                "type": "object",
                "properties": {
                  "asciimath": {
                    "type": "string"
                  },
                  "mathml": {
                    "type": "string"
                  },
                  "latex": {
                    "type": "string"
                  },
                  "omml": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "FigurePayload",
                "type": "object",
                "properties": {
                  "alt": {
                    "type": "string"
                  },
                  "uri": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "mirror": {
                    "type": "object"
                  }
                }
              },
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "TermPayload",
                "type": "object",
                "properties": {
                  "concept": {
                    "type": "string"
                  },
                  "designations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "admitted": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "deprecated": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "definition": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "title": "TermSourceEntry",
                      "type": "object",
                      "properties": {
                        "citeas": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "RequirementPayload",
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "class": {
                    "type": "string"
                  },
                  "obligation": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "statement": {
                    "type": "string"
                  },
                  "inherits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "ReferencePayload",
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "cited": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "required": [
          "unit_id",
          "type",
          "payload"
        ]
      }
    }
  },
  "required": [
    "text",
    "blocks"
  ]
}
