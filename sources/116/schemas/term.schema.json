{
  "$id": "https://metanorma.org/schemas/mko/term.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MN 116 TermPayload",
  "type": "object",
  "required": ["designations"],
  "properties": {
    "concept": { "type": "string" },
    "designations": { "type": "array", "items": { "type": "string" } },
    "admitted": { "type": "array", "items": { "type": "string" } },
    "deprecated": { "type": "array", "items": { "type": "string" } },
    "definition": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "object", "properties": { "citeas": { "type": "string" } } } }
  },
  "additionalProperties": true
}
